ENVIRONMENT=production

DB_USER=postgres
DB_PASSWORD=change_this_password_in_docker_compose_env
DB_NAME=shop_db
DATABASE_URL="postgresql+asyncpg://postgres:change_this_password_in_docker_compose_env@db:5432/shop_db"

REDIS_URL="redis://redis:6379/0"
CELERY_BROKER="redis://redis:6379/1"

SECRET_KEY="your-very-long-random-secret-key-for-production-change-this"
WEBHOOK_SECRET="your-webhook-secret-key-for-production"

SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

LOG_KAFKA_ENABLED=true
LOG_KAFKA_BROKER="kafka:9092"
LOG_KAFKA_TOPIC="app-logs"

GRAFANA_USER="admin"
GRAFANA_PASSWORD="change_this_password"

ALLOWED_ORIGINS=["https://yourdomain.com"]

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password_in_docker_compose_env
POSTGRES_DB=shop_db
