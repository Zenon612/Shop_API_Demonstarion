ENVIRONMENT=development

MOCK_DATABASE_URL="sqlite+aiosqlite:///./test.db"
DATABASE_URL="postgresql+asyncpg://postgres:change_this_password@localhost:5432/shop_db"
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER="redis://localhost:6379/1"

SECRET_KEY="your-super-long-random-secret-key-change-this-to-something-random-and-long"
WEBHOOK_SECRET="your-webhook-secret-key-change-this-too"

SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

LOG_KAFKA_ENABLED=false
LOG_KAFKA_BROKER="kafka:9092"
LOG_KAFKA_TOPIC="app-logs"

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
